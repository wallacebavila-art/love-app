rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'wallace@para-raissa.firebaseapp.com';
    }

    function isRaissa() {
      return isAuthenticated() && request.auth.token.email == 'raissa@para-raissa.firebaseapp.com';
    }

    function isAuthorizedUser() {
      return isAdmin() || isRaissa();
    }

    // Regras para mensagens - apenas admin e raissa podem escrever
    match /mensagens/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedUser();
    }

    // Regras para versículos - apenas admin e raissa podem escrever
    match /verses/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedUser();
    }

    // Regras para fotos - apenas admin pode escrever
    match /photos/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regras para timeline - apenas admin e raissa podem escrever
    match /timeline/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedUser();
    }

    // Regras para fcm_tokens - usuários autenticados podem registrar seu próprio token
    match /fcm_tokens/{document=**} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }

    // Regras para notificações - admin e raissa podem escrever
    match /notifications/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedUser();
    }

    // Regras para lugares visitados (mapa de viagens) - apenas admin e raissa podem escrever
    match /places/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedUser();
    }

    // Regras para usuários - apenas admin pode escrever
    match /users/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
